#!/usr/bin/env python3
"""ignition's screen-time tracker for KDE Plasma: records which window is in front and sends it to the
ignition server. The ignition-tracker user service runs it; `ignition-tracker status` asks the running one
how it's doing."""
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "server"))
from screen import tracker  # noqa: E402


def main():
    args = sys.argv[1:]
    if args in ([], ["run"]):
        tracker.run()
    elif args == ["status"]:
        import dbus
        try:
            obj = dbus.SessionBus().get_object(tracker.BUS_NAME, tracker.OBJECT_PATH)
            print(json.dumps(json.loads(obj.Status(dbus_interface=tracker.BUS_NAME)), indent=2))
        except dbus.DBusException:
            sys.exit("The tracker isn't running. Start it: systemctl --user start ignition-tracker")
    else:
        sys.exit("usage: ignition-tracker [run | status]")


if __name__ == "__main__":
    main()
